{
  "manifest_version": 2,
  "name": "SwagaBrowser JavaScript Bridge",
  "version": "1.0.0",
  "description": "Session-scoped JavaScript bridge for SwagaBrowser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "swaga-js-bridge@swaga.browser"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
